# Keep the published archive lean.

# The README references screenshots via absolute raw.githubusercontent.com URLs,
# so they render on pub.dev without shipping the (large) image files.
screenshots/
implementasi_plan.md

# Build artifacts and tool caches (a .pubignore takes precedence over .gitignore,
# so these must be listed explicitly or they'd be bundled — e.g. example/build).
build/
.dart_tool/
